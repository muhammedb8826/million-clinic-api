{
  "kind": "singleType",
  "collectionName": "homes",
  "info": {
    "singularName": "home",
    "pluralName": "homes",
    "displayName": "Home"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article"
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "section.testimonials",
        "section.stats",
        "section.gallery",
        "section.cta",
        "section.content",
        "components.slides",
        "section.features",
        "section.accordions",
        "section.video-section",
        "section.cards",
        "shared.rich-text",
        "shared.quote",
        "shared.media",
        "section.tab-section"
      ]
    },
    "events": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event.event"
    }
  }
}
