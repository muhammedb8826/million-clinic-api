HOST=0.0.0.0
PORT=1337
# Public URL of the deployed Strapi app (no trailing slash)
PUBLIC_URL=https://mako-portal.qenenia.com
# Set during admin build on the server so uploads hit the correct backend
STRAPI_ADMIN_BACKEND_URL=https://mako-portal.qenenia.com
# If uploads fail with "Unexpected token '<'" on the VPS, the reverse proxy
# (nginx/LiteSpeed) is blocking multipart POST to /upload. See deploy/nginx.example.conf
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
